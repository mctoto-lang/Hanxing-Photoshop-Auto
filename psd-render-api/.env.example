# ===== PSD 渲染服务 后端环境变量（第二期）=====
# 复制为 .env 并按需修改

# 服务端口
PORT=3000
HOST=0.0.0.0

# 运行模式：development | production | test
# production：生产模式，强制各项安全配置（详见 env.ts 跨字段校验）
# test：测试模式（CI 使用）
NODE_ENV=development

# 数据库（第三期改造：统一使用 SQLite，无需 PostgreSQL）
# 本地开发：file:./dev.db
# Docker 部署：file:/data/psd-render.db（由 docker-compose 卷挂载）
# 启动时自动启用 WAL 模式 + busy_timeout=5000ms + synchronous=NORMAL（见 src/lib/prisma.ts）
DATABASE_URL="file:./dev.db"

# API Key 鉴权
# P2-6：生产环境禁止使用 sk_live_poc_demo 开头的示例密钥
# 生成方式：openssl rand -hex 24，前缀加 sk_live_，如 sk_live_<hex>
# 明文示例（仅 POC）：sk_live_poc_demo_2026（生产禁止使用，env.ts 会拒绝启动）
API_KEY=sk_live_poc_demo_2026
# 若启用 bcrypt 校验，留空则明文比较（仅 POC 使用）
API_KEY_BCRYPT_HASH=

# Worker 短期令牌签名密钥
# P2-6：生产建议 min(32) 位随机字符串（可用 openssl rand -hex 32 生成）
# 此密钥同时用于 secret-crypto.ts 的 AES-256-GCM 加密 key 派生，
# 一旦设定后不可随意修改（修改后已加密的 COS Secret 等配置将无法解密）
WORKER_TOKEN_SECRET=change-me-in-production
# Worker 注册凭据（两种模式，可共存）：
#   1. 一次性配对码模式（推荐）：管理员在 Admin UI 生成 6 位配对码，Worker UI 输入即可注册
#      — 配对码 24h 过期，一次性使用，无需在 .env 配置任何内容
#      — Admin UI 路径：Worker 注册配对码 → 生成配对码
#   2. 长期密钥模式（兼容旧 Worker）：配置 WORKER_REGISTER_SECRET，与 config.json registerSecret 一致
#      — 生产强制非空；development 下留空时仅允许 loopback 注册
#      — 生成方式：openssl rand -hex 32
WORKER_REGISTER_SECRET=

# 存储后端：local | cos
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# P2-6：保留期至少 1 天（min(1)）
INPUT_RETENTION_DAYS=1
OUTPUT_RETENTION_DAYS=3
# P2-6：输入大小上限 1-500MB
MAX_INPUT_SIZE_MB=150

# COS 配置（STORAGE_BACKEND=cos 时必填）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 内网域名（与 CVM 同地域走内网），例：cos.ap-guangzhou.myqcloud.com
# 留空则使用公网域名
COS_INTERNAL_DOMAIN=
# 预签名 URL 有效期（秒）；COS 上限 7 天（604800）
COS_PRESIGN_EXPIRES_SECONDS=3600

# CORS 允许来源（逗号分隔）
# P2-6：生产环境禁止使用 * 通配，请配置具体允许的源
# Admin UI 跨子域场景需在此列出所有访问源
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# 任务队列（第三期改造：统一使用内存队列，无需 Redis）
# 保留 bullmq 枚举仅为向后兼容老 .env；设为 bullmq 时会自动降级为 memory 并打印警告
QUEUE_BACKEND=memory
# P2-6：租约 TTL 至少 30 秒
LEASE_TTL_SECONDS=90
# P2-6：心跳间隔 10-300 秒
HEARTBEAT_INTERVAL_SECONDS=30
MAX_ATTEMPTS=3
# P2-6：长轮询等待 5-60 秒
CLAIM_MAX_WAIT_SECONDS=20

# 监控告警阈值（第二期）
ALERT_WORKER_OFFLINE_SECONDS=120
ALERT_JOB_FAILED_RATE_THRESHOLD=0.3
ALERT_QUEUE_BACKLOG_THRESHOLD=50
ALERT_PS_STUCK_SECONDS=300
ALERT_EVAL_INTERVAL_SECONDS=60
ALERT_REAP_MIN_AGE_SECONDS=600

# 任务取消 - Worker 阶段边界检查间隔
CANCEL_CHECK_INTERVAL_SECONDS=5

# ===== 第三期 M3：Admin UI 鉴权 =====
# 是否启用 Admin 鉴权（false 时降级为 POC 模式无鉴权；生产必须为 true）
# P0 高危修复（H2）：生产环境（NODE_ENV=production）强制 ADMIN_AUTH_ENABLED=true，
#   env.ts 会在生产模式且 ADMIN_AUTH_ENABLED=false 时拒绝启动
# 接受：true/false/1/0/yes/no/on/off（不区分大小写）
ADMIN_AUTH_ENABLED=true
# Admin session 有效期（小时）；P2-6：1-72
ADMIN_SESSION_TTL_HOURS=8
# Admin IP 白名单（CIDR 或单 IP，逗号分隔；留空表示不限制）
# 例：10.0.0.1,192.168.1.0/24
ADMIN_IP_WHITELIST=
# 启动时引导创建的初始管理员账号（仅当 DB 无 active 管理员时生效）
# 生产环境必须修改 ADMIN_BOOTSTRAP_PASSWORD
ADMIN_BOOTSTRAP_USERNAME=admin
# P2-6：密码策略——至少 12 位，且包含大写/小写/数字/特殊符号中的至少 3 类
# 示例合规密码（仅 .env.example，请部署时修改）：
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe!Secure2026
# Cookie 域（留空则不设置 domain，仅限当前 host）
# 跨子域场景配置，如 .example.com（前导点表示含子域）
ADMIN_COOKIE_DOMAIN=
# Admin 会话 Cookie 是否带 Secure 标志（仅 HTTPS 才能发送）
# - 留空（默认）：production 自动启用，development/test 自动禁用
# - 显式设为 true/false（或 1/0、yes/no、on/off）可强制覆盖
# 常见排障：Docker 容器内通过 HTTP 直接访问（无 HTTPS 反代）时，
#   若登录后没有跳转（停在登录页），原因是浏览器拒绝存储带 Secure 的 cookie，
#   此时显式设 ADMIN_COOKIE_SECURE=false 即可
ADMIN_COOKIE_SECURE=

# ===== 第三期 M9：字体许可证管理 =====
# 是否强制要求字体许可证备注（true 时：注册无 licenseNote 不自动发布；发布前必须设置）
# 接受：true/false/1/0/yes/no/on/off（不区分大小写）
FONT_LICENSE_REQUIRED=true

# ===== 第三期 M10：告警通知渠道扩展 =====
# 通用 webhook URL（POST JSON：{ title, message, severity, type, refId, triggeredAt }）
# 留空表示不启用
# P2-6：URL 需通过 SSRF 静态校验（禁止内网/元数据地址，如 169.254.169.254）
ALERT_WEBHOOK_URL=
# 飞书机器人 webhook URL（https://open.feishu.cn/open-apis/bot/v2/hook/xxx）
# P2-6：URL 需通过 SSRF 静态校验
ALERT_FEISHU_WEBHOOK_URL=
# 钉钉机器人 webhook URL（https://oapi.dingtalk.com/robot/send?access_token=xxx）
# P2-6：URL 需通过 SSRF 静态校验
ALERT_DINGTALK_WEBHOOK_URL=
# 触发通知的最低告警级别（INFO / WARN / ERROR / CRITICAL）
# 默认 WARN：仅 WARN 及以上级别触发通知（INFO 不通知）
ALERT_MIN_SEVERITY=WARN
# 通知超时（毫秒）
ALERT_NOTIFY_TIMEOUT_MS=5000

# ===== 第三期 M12：存储后端覆盖 =====
# 生产环境存储后端（local | cos）
# docker-compose 默认 local；如使用腾讯云 COS 改为 cos 并填写上方 COS_* 配置
# STORAGE_BACKEND=cos
