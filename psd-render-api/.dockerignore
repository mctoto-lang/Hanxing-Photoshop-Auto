# PSD 渲染服务 - Docker 构建忽略清单（第三期 M12）
# 减少构建上下文体积，加速镜像构建

# 依赖与构建产物（在镜像内重新生成）
# 注:必须使用前导 / 限定根目录,否则 `storage` 会匹配 src/services/storage 源码目录
/node_modules
/dist
**/*.tsbuildinfo

# 本地数据与日志
/dev.db
/dev.db-journal
*.db
*.db-journal
/storage
/logs
*.log
/server.log
/server-err.log

# 环境变量与密钥（生产通过 docker-compose env_file 注入）
.env
.env.local
.env.*.local

# 版本控制与 IDE
.git
.gitignore
.vscode
.idea
*.swp

# 测试与脚本（不影响生产运行）
__tests__
*.test.ts
*.spec.ts
scripts/seed-*.mjs
scripts/test-*.mjs
scripts/verify-*.ts

# 文档
docs
*.md
LICENSE.txt

# OS 残留
.DS_Store
Thumbs.db
