// PSD 渲染服务平台 - PostgreSQL 生产 schema（第二期）
// 由 prisma/schema.prisma 派生，仅 datasource.provider 不同。
// 切换方式：npm run prisma:use-pg（将本文件复制为 schema.prisma）
// 切回 SQLite：npm run prisma:use-sqlite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== 枚举（SQLite 无原生枚举，使用字符串常量） =====

// ==================== API Key（调用方鉴权） ====================
model ApiKey {
  id          String   @id @default(cuid())
  keyPrefix   String   @unique
  keyHash     String   @unique
  name        String
  tenantId    String   @default("default")
  active      Boolean  @default(true)
  priority    Int      @default(5)
  rateLimitPerMin Int?
  // 第三期 M1：日配额
  quotaPerDay Int?
  quotaUsedDay Int     @default(0)
  quotaResetAt DateTime?
  // 第三期 M1：作用域
  scopes      String   @default("")
  // 第三期 M1：默认 webhook 配置
  webhookUrlDefault String?
  webhookSecret String?
  // 第三期 M1：IP 白名单
  ipWhitelist String?
  // 第三期 M1：禁用时间
  disabledAt  DateTime?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  jobs        RenderJob[]

  @@index([tenantId, active])
}

model Template {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  status    String   @default("DRAFT")
  tenantId  String   @default("default")
  versions  TemplateVersion[]
  bindings  LayerBinding[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([tenantId])
}

model TemplateVersion {
  id            String   @id @default(cuid())
  code          String   @unique
  template      Template @relation(fields: [templateId], references: [id])
  templateId    String
  version       Int      @default(1)
  psdObjectKey  String
  psdSha256     String
  canvasWidth   Int?
  canvasHeight  Int?
  layerSchema   String
  layerTree     String
  psMinVersion  String   @default("25.0")
  // 第三期 M8：缩略图对象 key（PSD 解析时生成的预览图）
  thumbnailObjectKey String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())

  jobs          RenderJob[]

  @@unique([templateId, version])
  @@index([templateId, published])
}

model LayerBinding {
  id              String   @id @default(cuid())
  template        Template @relation(fields: [templateId], references: [id])
  templateId      String
  bindingId       String
  layerId         Int
  layerPath       String
  type            String
  required        Boolean  @default(true)
  label           String?
  acceptedFormats String   @default("jpg,png,jpeg")
  fit             String?
  maxLength       Int?
  defaultFontVersionId String?
  createdAt       DateTime @default(now())

  @@unique([templateId, bindingId])
  @@index([templateId])
}

model FontVersion {
  id              String   @id @default(cuid())
  code            String   @unique
  familyName      String
  postscriptName  String
  style           String   @default("Regular")
  fileObjectKey   String
  sha256          String
  licenseNote     String?
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  fontConfig      FontConfig?

  @@unique([postscriptName, style])
  @@index([familyName])
}

model FontConfig {
  id                    Int          @id @default(1)
  fallbackFontVersionId String?      @unique
  fallbackFontVersion   FontVersion? @relation(fields: [fallbackFontVersionId], references: [id], onDelete: Restrict)
  updatedAt             DateTime     @updatedAt
}

model Worker {
  id                  String   @id @default(cuid())
  code                String   @unique
  customCode          String?  @unique
  displayName         String?
  machineFingerprint  String   @unique
  psVersion           String
  capabilities        String   @default("[]")
  fontInventoryHash   String?
  // P0：accessToken 仅在注册/刷新时返回明文，DB 存其 SHA-256 hash
  accessToken         String?
  accessTokenHash     String?  @unique
  tokenExpiresAt      DateTime?
  sessionActive       Boolean  @default(false)
  currentJobId        String?
  lastHeartbeatAt     DateTime?
  offlineSince        DateTime?
  psMajorVersion      Int      @default(0)
  os                  String   @default("unknown")
  registeredAt        DateTime @default(now())

  jobs                RenderJob[]
  heartbeats          JobHeartbeat[]

  @@index([sessionActive])
  @@index([lastHeartbeatAt])
}

model StorageConfig {
  id                    Int      @id @default(1)
  backend               String   @default("local")
  localStorageDir       String?
  cosBucket             String?
  cosRegion             String?
  cosInternalDomain     String?
  cosPresignExpiresSec  Int?
  cosSecretIdEncrypted  String?
  cosSecretKeyEncrypted String?
  updatedAt             DateTime @updatedAt
}

model RenderJob {
  id                String   @id @default(cuid())
  code              String   @unique
  idempotencyKey    String
  tenantId          String   @default("default")
  apiKey            ApiKey?  @relation(fields: [apiKeyId], references: [id])
  apiKeyId          String?
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])
  templateVersionId String
  inputJson         String
  outputFormat      String   @default("png")
  status            String   @default("QUEUED")
  priority          Int      @default(5)
  attempt           Int      @default(0)
  maxAttempts       Int      @default(3)
  jsxTimeoutSeconds Int      @default(600)
  requiredCapabilities String?
  targetWorkerId    String?
  cancelRequestedAt DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  worker            Worker?  @relation(fields: [workerId], references: [id])
  workerId          String?
  leaseToken        String?
  leaseExpiresAt    DateTime?
  stage             String?
  progress          Int      @default(0)
  errorCode         String?
  errorMessage      String?
  traceId           String?
  webhookUrl        String?
  webhookDelivered  Boolean  @default(false)
  queuedAt          DateTime @default(now())
  leasedAt          DateTime?
  processingAt      DateTime?
  succeededAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  artifacts         Artifact[]
  heartbeats        JobHeartbeat[]

  @@unique([tenantId, idempotencyKey])
  @@index([status, priority, queuedAt])
  @@index([workerId])
  @@index([targetWorkerId])
  @@index([cancelRequestedAt])
}

model JobHeartbeat {
  id        String   @id @default(cuid())
  job       RenderJob @relation(fields: [jobId], references: [id])
  jobId     String
  worker    Worker?  @relation(fields: [workerId], references: [id])
  workerId  String?
  stage     String?
  progress  Int      @default(0)
  message   String?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
}

model Artifact {
  id          String   @id @default(cuid())
  code        String   @unique
  job         RenderJob? @relation(fields: [jobId], references: [id])
  jobId       String?
  kind        String
  objectKey   String
  sha256      String
  mimeType    String
  sizeBytes   Int      @default(0)
  bindingId   String?
  originalName String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  // P0 安全修复（高危7）：租户隔离字段（详见 schema.prisma 同名字段注释）
  tenantId    String   @default("default")

  @@index([jobId, kind])
  @@index([expiresAt])
  @@index([tenantId])
}

model WebhookLog {
  id          String   @id @default(cuid())
  // 幂等事件 ID：{jobId}.{event}（同一任务同一事件仅投递一次）
  eventId     String   @unique
  jobId       String
  // 事件类型：job.succeeded | job.failed | job.cancelled
  event       String
  targetUrl   String
  // 关联的 API Key（用于取 webhookSecret）
  apiKeyId    String?
  // 完整 payload（JSON 字符串）
  payload     String
  // PENDING | DELIVERED | FAILED | RETRYING
  status      String   @default("PENDING")
  attempt     Int      @default(0)
  maxAttempts Int      @default(6)
  // 下次重试时间（指数退避）
  nextAttemptAt DateTime?
  responseCode Int?
  responseBody String?
  lastError   String?
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

model AlertEvent {
  id          String   @id @default(cuid())
  type        String
  severity    String   @default("WARN")
  refType     String?
  refId       String?
  title       String
  message     String
  metrics     String?
  status      String   @default("ACTIVE")
  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?
  ackedBy     String?
  ackedAt     DateTime?
  createdAt   DateTime @default(now())

  @@index([type, status])
  @@index([triggeredAt])
}

// ==================== 管理员用户与 Session（第三期 M3） ====================
model AdminUser {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  // admin | operator | viewer
  role          String   @default("viewer")
  active        Boolean  @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sessions      AdminSession[]

  @@index([active])
}

model AdminSession {
  id            String   @id @default(cuid())
  // P0 安全修复：token 明文仅在创建时返回给客户端，DB 不再落明文，仅存 SHA-256 hash。
  //   旧字段 token 改为可空，仅用于历史数据兼容；新会话不写入。
  //   防止 DB 泄露时攻击者直接读取 token 列冒充任意管理员。
  token         String?  @unique
  tokenHash     String   @unique
  adminUser     AdminUser @relation(fields: [adminUserId], references: [id])
  adminUserId   String
  expiresAt     DateTime
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

// ==================== 审计日志（第三期 M2） ====================
model AuditLog {
  id          String   @id @default(cuid())
  // 动作类别：admin_login | admin_logout | api_key_create | api_key_rotate | api_key_disable | api_key_enable | api_key_delete | api_key_update | template_publish | template_archive | template_unarchive | template_delete | font_publish | font_unpublish | font_license_note | font_delete | font_upload | worker_force_offline | worker_reapprove | worker_display_name_update | worker_custom_code_update | job_force_cancel | job_release_lease | job_retry | job_batch_cancel | admin_user_create | admin_user_disable | admin_user_enable | admin_user_password | admin_user_role
  action      String
  // 执行者：admin username 或 'system' / 'unknown'
  actor       String
  actorIp     String?
  actorUa     String?
  // 结果：success | failure
  result      String   @default("success")
  // 关联资源类型：api_key | template | font | worker | job | admin_user | alert | system
  refType     String?
  refId       String?
  // 简短描述
  message     String?
  // 详细元数据（JSON 字符串）
  meta        String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([actor, createdAt])
  @@index([refType, refId])
  @@index([createdAt])
}
